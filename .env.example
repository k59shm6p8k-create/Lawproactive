# ── Environment variables (template) ────────────────────────────────────────
# Copy to .env.local for local dev, and set the SAME keys in Vercel:
#   Vercel → Project → Settings → Environment Variables → Production (+ Preview).
# Never commit real values — .env.local is gitignored. This file is names only.

# ── REQUIRED: Supabase (lead capture + attorney data) ───────────────────────
# Supabase → Project Settings → API
#   Project URL            → NEXT_PUBLIC_SUPABASE_URL
#   service_role secret     → SUPABASE_SERVICE_ROLE_KEY  (server-only; keep secret)
# NOTE: the build won't crash if these are unset (placeholder fallback), but the
# live site needs the real values or lead forms / attorney data won't work.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── REQUIRED for go-live: site + lead routing ───────────────────────────────
NEXT_PUBLIC_DOMAIN=            # e.g. https://personalinjury.lawproactive.com
NEXT_PUBLIC_CRM_API_URL=       # lead-submission endpoint the forms POST to
NEXT_PUBLIC_PHONE_NUMBER=      # display phone, e.g. (555) 123-4567

# ── Analytics / ads (optional, but usually wanted at launch) ────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=   # Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=       # Google Ads, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=   # Meta Pixel id

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAILS=                  # comma-separated emails allowed into /admin

# NODE_ENV is set automatically by Vercel/Next — do NOT set it manually.
